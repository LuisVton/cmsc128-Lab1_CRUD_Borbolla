# Copy to .env (never commit .env). Names only, no real secrets here.
SECRET_KEY=
BASE_URL=http://127.0.0.1:5000
SESSION_COOKIE_SECURE=0
RESET_TOKEN_MINUTES=30
# Optional SMTP. If SMTP_HOST is empty, reset links go to the console + instance/outbox.log (demo mode).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
